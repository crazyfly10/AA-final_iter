title                   = HET-s 12-mer NPT equilibration
define                  = -DPOSRES

integrator              = md
dt                      = 0.004
nsteps                  = 250000        ; 1 ns
mass-repartition-factor	= 3

continuation            = yes
gen_vel                 = no

nstenergy               = 500
nstlog                  = 500
nstxout-compressed      = 5000

constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres
pme_order               = 4
fourierspacing          = 0.16

tcoupl                  = V-rescale
tc-grps                 = Prot_cyl Water_and_ions
tau_t                   = 1.0 1.0
ref_t                   = 298 298

pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5
refcoord_scaling        = com

pbc                     = xyz
comm-mode               = Linear
nstcomm                 = 100

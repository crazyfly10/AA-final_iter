integrator = md
dt         = 0.002
nsteps     = 100000          ; 200 ps
constraints = h-bonds
constraint_algorithm = lincs
cutoff-scheme = Verlet
nstlist    = 20
rlist      = 1.0
coulombtype = PME
rcoulomb   = 1.0
vdwtype    = Cut-off
vdw-modifier = Potential-shift
rvdw       = 1.0
DispCorr   = EnerPres
tcoupl     = V-rescale
tc-grps    = System
tau_t      = 0.5
ref_t      = 298
pcoupl     = C-rescale
pcoupltype = isotropic
tau_p      = 2.0
ref_p      = 1.0
compressibility = 4.5e-5
pbc        = xyz
gen_vel    = yes
gen_temp   = 298
gen_seed   = -1
nstenergy  = 500
nstlog     = 500

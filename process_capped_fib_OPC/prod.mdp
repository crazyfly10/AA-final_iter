itle                   = HET-s 12-mer production (unrestrained relaxation)

; Run control
integrator              = md
dt                      = 0.004
nsteps                  = 50000000     ; 200 ns
mass-repartition-factor = 3
continuation            = yes
gen_vel                 = no

; Output
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstlog                  = 2500         ; every 10 ps
nstenergy               = 2500         ; every 10 ps
nstxout-compressed      = 2500         ; every 10 ps
compressed-x-precision  = 1000

; Bond constraints
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

; Neighbour searching
cutoff-scheme           = Verlet
nstlist                 = 40
rlist                   = 1.0

; Non-bonded interactions
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
rvdw                    = 1.0
DispCorr                = EnerPres

; PME
pme_order               = 4
fourierspacing          = 0.12
ewald_rtol              = 1e-5

; Temperature coupling
tcoupl                  = V-rescale
tc-grps                 = Protein Water_and_ions
tau_t                   = 1.0 1.0
ref_t                   = 298 298

; Pressure coupling
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 5.0
ref_p                   = 1.0
compressibility         = 4.5e-5

; Periodic boundaries
pbc                     = xyz

; Centre-of-mass motion removal
comm-mode               = Linear
nstcomm                 = 100
